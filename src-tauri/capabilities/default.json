{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main and overlay windows",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "opener:default",
    "global-shortcut:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/mem0-server",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "process:default",
    "store:default",
    "notification:default",
    "window-state:default"
  ]
}
