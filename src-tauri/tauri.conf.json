{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omni",
  "version": "0.1.0",
  "identifier": "com.omni.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omni Dashboard",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Omni Overlay",
        "width": 400,
        "height": 200,
        "minWidth": 400,
        "minHeight": 50,
        "maxWidth": 400,
        "maxHeight": 900,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active",
          "color": [10, 10, 14, 180]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* https://*.supabase.co https://api.openai.com https://api.anthropic.com https://api.deepseek.com https://api.elevenlabs.io https://api.mem0.ai; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mem0-server"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
